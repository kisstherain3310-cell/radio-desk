GEMINI_API_KEY=your_gemini_api_key_here

# 광고 HTML (선택) — 비우면 프로토타입 슬롯 표시
# AD_HTML_HOME_TOP=
# AD_HTML_CRYPTO=
# AD_HTML_STOCKS=
# AD_HTML_READER_LEFT=
# AD_HTML_READER_RIGHT=

# SIGNALS / X API (선택 · 이후 스프린트)
# X_BEARER_TOKEN=

# 개인 단말 모드 (선택) — 혼자 쓰는 로컬 실행에서만 1로 켜세요.
# 켜면 사이드바 "설정 저장"이 data/user_settings.json 에 저장되고 다음 실행에 복원됩니다.
# 공개 배포에서는 절대 켜지 마세요. 서버 파일 하나를 방문자 전원이 공유해서
# 한 사람의 저장이 모든 방문자의 초기 설정을 바꿔 버립니다.
# RD_PERSONAL_MODE=1
